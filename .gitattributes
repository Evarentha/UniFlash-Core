# The repository stores LF and checks out LF on every platform so that
# Windows checkouts do not rewrite sources and change diffs.
* text=auto eol=lf

*.md text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.in text eol=lf
*.yml text eol=lf

# SHA-256 lists and hashes are byte data.
*.sha256 -text
*.zip -text
*.xz -text
*.tar -text
